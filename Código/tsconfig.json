{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": ["backend/src/**/*.ts", "backend/prisma/**/*.ts", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
}
